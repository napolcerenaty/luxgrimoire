# API Environment Variables
# Copy to .env and fill in real values

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luxgrimoire_v2

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary
# Use your DEV account credentials here (local/.env)
# Use PRODUCTION account credentials on the hosting platform (Render env vars)
# Create two free accounts: one for prod, one for dev/test
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary migration (scripts/cloudinary-migrate.js)
# Set these only when running a migration — do NOT commit real values
# MIGRATE_SRC_CLOUD_NAME=    # source account (e.g. production)
# MIGRATE_SRC_API_KEY=
# MIGRATE_SRC_API_SECRET=
# MIGRATE_DST_CLOUD_NAME=    # destination account (e.g. dev)
# MIGRATE_DST_API_KEY=
# MIGRATE_DST_API_SECRET=

# Brevo SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=a7efb6001@smtp-brevo.com
BREVO_SMTP_KEY=

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=change-me-typesense-key

# App
APP_PORT=3001
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# OpenAI (for AI book/edition parser)
OPENAI_API_KEY=sk-...

# Sentry error monitoring (optional — leave empty to disable)
SENTRY_DSN=
BACKUP_DIR=./backups          # path to store backup files (default: apps/api/backups)
BACKUP_RETENTION_DAYS=14      # delete backups older than N days
BACKUP_KEEP_LAST=7            # always keep at least N most recent backups
# PGDUMP_PATH=                # full path to pg_dump.exe if not in PATH (Windows)
JWT_COOKIE_NAME=jwt
FRONTEND_URL=http://localhost:3000

# Web Push (VAPID) — generate with: node -e "require('web-push').generateVAPIDKeys()"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@luxgrimoire.com
