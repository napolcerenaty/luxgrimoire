NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API URL for SSR (server-side rendering) — set in Coolify as runtime variable.
# Should point to API container via Docker internal network, e.g. http://api-container-name:3001/api
# If not set, falls back to NEXT_PUBLIC_API_URL.
API_URL=

# Sentry error monitoring (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time only, not needed locally — auth token for uploading source maps to Sentry so
# production stack traces resolve to real file/line instead of minified names. Sentry ->
# Settings -> Auth Tokens, scope project:releases. Set as a GitHub Actions secret in CI.
SENTRY_AUTH_TOKEN=

# Web Push VAPID public key (same value as VAPID_PUBLIC_KEY in API)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
