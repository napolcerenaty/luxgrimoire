  notes           String?
  createdAt       DateTime              @default(now())
  purchaseGroupId String?
  billingPeriod   UserSubBillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  feeTemplate     UserFeeTemplate?      @relation(fields: [feeTemplateId], references: [id])
  purchaseGroup   UserPurchaseGroup?    @relation(fields: [purchaseGroupId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([billingPeriodId])
  @@index([purchaseGroupId])
  @@map("user_purchase_fees")
}

