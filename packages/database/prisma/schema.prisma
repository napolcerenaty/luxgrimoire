/// Reusable fee templates defined by the user (e.g. "Polish Customs VAT", "DHL Processing Fee")
model UserFeeTemplate {
  id                  String                             @id @default(uuid())
  userId              String
  name                String
  category            FeeCategory                        @default(OTHER)
  defaultAmount       Decimal?                           @db.Decimal(10, 2)
  defaultCurrency     String                             @default("PLN")
  isActive            Boolean                            @default(true)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  user                User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseFees        UserPurchaseFee[]
  subscriptionEntries UserSubscriptionEntryFeeTemplate[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("user_fee_templates")
}

/// Links a fee template to a subscription entry — these templates auto-apply on each billing period
model UserSubscriptionEntryFeeTemplate {
  subscriptionEntryId String
  feeTemplateId       String
  /// Optional per-subscription override amount (if null, uses template's defaultAmount)
  customAmount        Decimal?              @db.Decimal(10, 2)
  createdAt           DateTime              @default(now())
  /// Optional per-subscription override currency (if null, uses template's defaultCurrency)
  customCurrency      String?
  feeTemplate         UserFeeTemplate       @relation(fields: [feeTemplateId], references: [id], onDelete: Cascade)
  entry               UserSubscriptionEntry @relation(fields: [subscriptionEntryId], references: [id], onDelete: Cascade)

  @@id([subscriptionEntryId, feeTemplateId])
  @@index([subscriptionEntryId])
  @@map("user_subscription_entry_fee_templates")
}

/// Individual fee/tax instance linked to a billing period or book entry
model UserPurchaseFee {
  id              String                @id @default(uuid())
