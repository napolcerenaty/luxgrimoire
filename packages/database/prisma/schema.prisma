  @@index([entryId])
  @@map("user_subscription_cost_changes")
}

/// Subscription-level base price changes set by admin, effective from a given month.
/// Tracks historical changes to subscription renewal/billing settings.
/// Used by backfill to reconstruct the correct renewalDate for each past month
/// based on settings that were in effect at that time (renewalDay, offset, etc.).
model SubscriptionSettingsHistory {
  id             String   @id @default(uuid())
  subscriptionId String

  /// When this configuration took effect (UTC, first day of effect)
  effectiveFrom  DateTime

  /// null = renewalDayUserSet mode (each subscriber uses their own sign-up day)
  renewalDay                 Int?
  renewalDayUserSet          Boolean
  paymentOnStartup           Boolean
  signupIncludesCurrentMonth Boolean
  renewalMonthOffset         Int

  changedBy  String?  /// userId of admin who made the change (for audit)
  notes      String?
  createdAt  DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, effectiveFrom])
  @@map("subscription_settings_history")
}

model SubscriptionPriceChange {
  id                 String       @id @default(uuid())
  subscriptionId     String
  effectiveMonth     Int
  effectiveYear      Int
  newBasePrice       Decimal      @db.Decimal(10, 2)
  currency           String       @db.VarChar(3)
  notes              String?
  grandfatheredPrice Boolean      @default(false)
  createdAt          DateTime     @default(now())
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, effectiveYear, effectiveMonth, currency])
  @@index([subscriptionId])
  @@map("subscription_price_changes")
}

