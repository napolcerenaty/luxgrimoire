model UserSubscriptionEntry {
  id                 String                             @id @default(uuid())
  userId             String
  subscriptionId     String
  startDate          String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  active             Boolean                            @default(true)
  addedAt            DateTime                           @default(now())
  cancellationDate   String?
  companyId          String?
  firstSkipDate      DateTime?
  renewalDay         Int?
  shippingCost       Decimal?                           @db.Decimal(10, 2)
  startingMonth      Int?
  nextRenewalDate    DateTime?
  prepaidMonths      Int                                @default(1)
  costCurrency       String?
  basePrice          Decimal?                           @db.Decimal(10, 2)
  cancellationReason String?
  shippingCountry    String?                            @db.VarChar(2)
  trackingNumber     String?
  scheduledPrepayOptionId String?
  isForwarding            Boolean                            @default(false)
  skipRecords        UserSkipRecord[]
  billingPeriods     UserSubBillingPeriod[]
  tags               UserSubEntryTag[]
  costChanges        UserSubscriptionCostChange[]
  bookEntries        UserBookEntry[]
  renewalHistory     UserSubscriptionRenewal[]
  subscription       Subscription                       @relation(fields: [subscriptionId], references: [id])
  user               User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeTemplates       UserSubscriptionEntryFeeTemplate[]
  purchaseGroups     UserPurchaseGroup[]
  scheduledPrepayOption   SubscriptionPrepayOption? @relation("ScheduledPrepay", fields: [scheduledPrepayOptionId], references: [id])

  @@index([userId])
  @@index([userId, active])
  @@index([active, nextRenewalDate])
  @@index([subscriptionId, shippingCountry])
  // Partial unique index enforced in DB: only one active entry per user+sub.
  // Full definition: CREATE UNIQUE INDEX ... WHERE "active" = true
  @@index([userId, subscriptionId], map: "user_subscription_entries_active_unique")
  @@map("user_subscription_entries")
}

model UserSubBillingPeriod {
  id                    String                 @id @default(uuid())
  entryId               String
  monthId               String?
