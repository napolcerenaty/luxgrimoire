generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                      @id @default(uuid())
  username                 String                      @unique
  email                    String                      @unique
  emailVerified            Boolean                     @default(false)
  passwordHash             String?
  role                     Role                        @default(USER)
  preferredCurrency        String                      @default("EUR")
  displayName              String?
  avatarUrl                String?
  bio                      String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  managedCompanyId         String?
  timezone                 String                      @default("UTC")
  timeFormat               String                      @default("24h")
  defaultTaxRate           Decimal?                    @db.Decimal(5, 2)
  shippingCountry          String?                     @db.VarChar(2)
  termsAcceptedAt          DateTime?
  termsVersion             String?
  privacyAcceptedAt        DateTime?
  privacyVersion           String?
  onboardingCompletedAt    DateTime?
  statsSettings            Json?                       // { spending, sales, reading, features } booleans; null = all true
  accounts                 Account[]
  auditLogs                AuditLog[]
  submittedEditions        BookEdition[]               @relation("SubmittedEditions")
  communityImages          UserEditionImage[]
  purchases                PurchaseTransaction[]
  sessions                 Session[]
  waitlistEntries          SubscriptionWaitlistEntry[]
  bookEntries              UserBookEntry[]
  editionTags              UserEditionTag[]
  bookEntryTags            UserBookEntryTag[]
  feeTemplates             UserFeeTemplate[]
  notifications            UserNotification[]
  notificationPreference   UserNotificationPreference?
  pushSubscriptions        PushSubscription[]
  reminderSettings         UserReminderSettings?
  scheduledReminders       ScheduledReminder[]
  purchaseDiscounts        UserPurchaseDiscount[]
  purchaseFees             UserPurchaseFee[]
  purchaseGroups           UserPurchaseGroup[]
  purchaseRefunds          UserPurchaseRefund[]
  saleInterests            UserSaleInterest[]
  saleGroups               UserSaleGroup[]
  skipRecords              UserSkipRecord[]
  subEntryTags             UserSubEntryTag[]
  subscriptionEntries      UserSubscriptionEntry[]
  statsSnapshots           UserStatsSnapshot[]
 
  subscriptionRenewals     UserSubscriptionRenewal[]
  bugReports               BugReport[]
  featureRequests          FeatureRequest[]
  featureVotes             FeatureVote[]
  dataRequests             DataRequest[]
  saleAnnouncementRequests SaleAnnouncementRequest[]
  managedCompany           BookBoxCompany?             @relation("CompanyManagers", fields: [managedCompanyId], references: [id])
  uploadedAssets           MediaAsset[]                @relation("MediaAssetUploads")

  @@index([shippingCountry])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id           String  @id @default(uuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model BookSeries {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]

  @@index([name])
  @@map("book_series")
}

model Book {
  id           String                  @id @default(uuid())
  slug         String                  @unique
  title        String
  description  String?
  language     String                  @default("en")
  seriesName   String?
  seriesId     String?
  volumeNumber Float?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  status       String                  @default("approved")
  genres       String[]
  series            BookSeries?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  authors           BookAuthor[]
  editions          BookEdition[]
  monthBooks        SubscriptionMonthBook[]
  userEntries       UserBookEntry[]
  editionComponents BookEditionComponent[]

  @@index([language])
  @@index([seriesName])
  @@index([seriesId])
  @@index([status])
  @@map("books")
}

model Author {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  bio         String?
  photoUrl    String?
  photoAssetId String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  facebook    String?
  instagram   String?
  nationality String?
  tiktok      String?
  twitter     String?
  website     String?
  books       BookAuthor[]
  photoAsset  MediaAsset?          @relation("AuthorPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)

  @@index([nationality])
  @@index([name])
  @@map("authors")
}

model BookAuthor {
  bookId   String
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model Artist {
  id            String               @id @default(uuid())
  slug          String               @unique
  name          String
  bio           String?
  photoUrl      String?
  photoAssetId  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  facebook      String?
  instagram     String?
  specialty     String?
  tiktok        String?
  twitter       String?
  website       String?
  contributions ArtistContribution[]
  cardArtistMonths SubscriptionMonth[]
  photoAsset    MediaAsset?          @relation("ArtistPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)

  @@index([specialty])
  @@index([name])
  @@map("artists")
}

model ArtistContribution {
  id         String      @id @default(uuid())
  editionId  String
  artistId   String
  role       String      @default("cover")
  artistName String?
  artist     Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  edition    BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, artistId, role])
  @@index([artistId])
  @@map("artist_contributions")
}

model BookEdition {
  id        String  @id @default(uuid())
  slug      String  @unique
  bookId    String
  publisher String?
  photoCredit              String?
  additionalImages         String[]
  editionImages            BookEditionMediaAsset[]
  isSpecial                Boolean                   @default(false)
  isOmnibus                Boolean                   @default(false)
  componentCount           Int                       @default(0)
  components               BookEditionComponent[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  basePrice                Decimal?                  @db.Decimal(10, 2)
  bookBoxCompanyCustomName String?
  bookBoxCompanyId         String?
  collectionId             String?
  currency                 String?
  earlyAccessDate          String?
  /// @deprecated Use EditionFeatureTag source='features' (rawValue) instead. book_editions.features[] will be removed after migration.
  features                 String[]
  firstAccessDate          String?
  generalSaleDate          String?
  language                 String?
  subscriptionId           String?
  subscriptionMonthId      String?
  submittedByUserId        String?
  verifiedAt               DateTime?
  previousEditionId        String?                   @unique
  previousEdition          BookEdition?              @relation("EditionHistory", fields: [previousEditionId], references: [id], onDelete: SetNull)
  nextEdition              BookEdition?              @relation("EditionHistory")
  artists                  ArtistContribution[]
  bookBoxCompany           BookBoxCompany?           @relation(fields: [bookBoxCompanyId], references: [id])
  book                     Book                      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  collection               BookBoxCollection?        @relation(fields: [collectionId], references: [id])
  submittedBy              User?                     @relation("SubmittedEditions", fields: [submittedByUserId], references: [id])
  saleEditions             SaleAnnouncementEdition[]
  monthBooks               SubscriptionMonthBook[]
  userEntries              UserBookEntry[]
  tags                     UserEditionTag[]
  communityImages          UserEditionImage[]
  saleStats                EditionSaleStat[]
  statsSnapshot            EditionStatsSnapshot?
  featureTags              EditionFeatureTag[]

  @@index([bookId])
  @@index([bookBoxCompanyId])
  @@index([subscriptionId])
  @@index([subscriptionMonthId])
  @@index([collectionId])
  @@index([language])
  @@index([generalSaleDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([verifiedAt])
  @@map("book_editions")
}

model BookEditionComponent {
  id           String      @id @default(uuid())
  editionId    String
  bookId       String?
  customTitle  String?
  volumeNumber Float?
  order        Int         @default(0)
  edition      BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  book         Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([bookId])
  @@map("book_edition_components")
}

model BookBoxCompany {
  id                String                @id @default(uuid())
  slug              String                @unique
  name              String
  description       String?
  logoUrl           String?
  logoAssetId       String?
  website           String?
  country           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  bluesky           String?
  defaultCurrency   String?
  facebook          String?
  instagram         String?
  iossImplemented              Boolean               @default(false)
  hasOfficialImagePermission   Boolean               @default(false)
  threads           String?
  tiktok            String?
  x                 String?
  brandColors       String[]
  collections       BookBoxCollection[]
  editions          BookEdition[]
  saleAnnouncements SaleAnnouncement[]
  subscriptions     Subscription[]
  managers          User[]                @relation("CompanyManagers")
  logoAsset         MediaAsset?           @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  @@index([country])
  @@map("book_box_companies")
}

model BookBoxCollection {
  id          String         @id @default(uuid())
  companyId   String
  name        String
  createdAt   DateTime       @default(now())
  isActive    Boolean        @default(true)
  slug        String         @unique
  updatedAt   DateTime       @updatedAt
  company     BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  editions    BookEdition[]

  @@index([companyId])
  @@map("book_box_collections")
}

model Subscription {
  id                   String                       @id @default(uuid())
  slug                 String                       @unique
  companyId            String
  name                 String
  description          String?
  coverImage           String?
  coverImageAssetId    String?
  genre                String?
  startDate            DateTime?
  endDate              DateTime?
  isDiscontinued       Boolean                      @default(false)
  currency             String                       @default("EUR")
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  bookishMerch         Boolean                      @default(false)
  genres               String[]
  isCombo              Boolean                      @default(false)
  logoUrl              String?
  logoAssetId          String?
  parentSubscriptionId String?
  renewalDay           Int?
  renewalDayUserSet    Boolean                      @default(false)
  shippingCountries    String[]
  shipsInternationally Boolean                      @default(false)
  startingMonth        Int?
  intervalMonths       Int                          @default(1)
  language             String?
  contentType          String                       @default("MIX")
  isHidden             Boolean                      @default(false)
  isUpcoming           Boolean                      @default(false)
  upcomingNote         String?
  waitlistLink         String?
  isContentStream      Boolean                      @default(false)
  isBundleSubscription Boolean                      @default(false)
  paymentOnStartup              Boolean                      @default(false)
  renewalMonthOffset            Int                          @default(0)
  signupIncludesCurrentMonth    Boolean                      @default(false)
  priceChanges             SubscriptionPriceChange[]
  settingsHistory          SubscriptionSettingsHistory[]
  comboComponents      SubscriptionComboComponent[] @relation("SubscriptionAsCombo")
  comboOf              SubscriptionComboComponent[] @relation("SubscriptionAsComponent")
  months               SubscriptionMonth[]
  prepayOptions        SubscriptionPrepayOption[]
  series               SubscriptionSeries[]
  skipPolicy           SubscriptionSkipPolicy?
  waitlistEntries      SubscriptionWaitlistEntry[]
  company              BookBoxCompany               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent               Subscription?                @relation("SubVariants", fields: [parentSubscriptionId], references: [id], onUpdate: NoAction)
  variants             Subscription[]               @relation("SubVariants")
  userEntries          UserSubscriptionEntry[]

  statsSnapshot        SubscriptionStatsSnapshot?
  countryFeeSnapshots  SubscriptionCountryFeeSnapshot[]
  coverImageAsset      MediaAsset?                  @relation("SubscriptionCover", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  logoAsset            MediaAsset?                  @relation("SubscriptionLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([intervalMonths])
  @@map("subscriptions")
}

model SubscriptionComboComponent {
  comboId     String
  componentId String
  combo       Subscription @relation("SubscriptionAsCombo", fields: [comboId], references: [id], onDelete: Cascade)
  component   Subscription @relation("SubscriptionAsComponent", fields: [componentId], references: [id], onDelete: Cascade)

  @@id([comboId, componentId])
  @@index([componentId])
  @@map("subscription_combo_components")
}

model SubscriptionSkipPolicy {
  subscriptionId         String       @id
  type                   String       @default("NONE")
  maxSkips               Int?
  maxConsecutive         Int?
  windowMonths           Int?
  notes                  String?
  skipHow                String?
  skipDeadlineDaysBefore Int          @default(0)
  skipDeadlineType       String       @default("DAYS_BEFORE")
  skipDeadlineDayOfMonth Int?
  allowUnskip              Boolean  @default(false)
  unskipDeadlineType       String   @default("DAYS_BEFORE")
  unskipDeadlineDaysBefore Int      @default(0)
  unskipDeadlineDayOfMonth Int?
  unskipNotes              String?
  unskipHow                String?
  eligibleBillingTypes     String   @default("ALL")
  subscription           Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_skip_policies")
}

model SubscriptionSeries {
  id              String              @id @default(uuid())
  subscriptionId  String
  slug            String              @unique
  name            String
  description     String?
  coverImage      String?
  coverImageAssetId String?
  startMonth      Int
  startYear       Int
  endMonth        Int
  endYear         Int
  skipMode        String              @default("INDIVIDUAL")
  canCancelDuring Boolean             @default(true)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  months          SubscriptionMonth[]
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  skipRecords     UserSkipRecord[]
  coverImageAsset MediaAsset?         @relation("SeriesCover", fields: [coverImageAssetId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("subscription_series")
}

model UserSkipRecord {
  id                  String                @id @default(uuid())
  userId              String
  userEntryId         String
  subscriptionMonthId String
  skippedAt           DateTime              @default(now())
  windowKey           String?
  undoneAt            DateTime?
  seriesId            String?
  series              SubscriptionSeries?   @relation(fields: [seriesId], references: [id])
  month               SubscriptionMonth     @relation(fields: [subscriptionMonthId], references: [id], onDelete: Cascade)
  userEntry           UserSubscriptionEntry @relation(fields: [userEntryId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userEntryId, subscriptionMonthId])
  @@index([userEntryId])
  @@index([userId])
  @@map("user_skip_records")
}

model UserSubscriptionSkipState {
  userId           String
  subscriptionId   String
  windowKey        String?
  skipsInWindow    Int       @default(0)
  consecutiveSkips Int       @default(0)
  totalSkips       Int       @default(0)
  lastSkipAt       DateTime?

  @@id([userId, subscriptionId])
  @@map("user_subscription_skip_states")
}

model SubscriptionPrepayOption {
  id               String                  @id @default(uuid())
  subscriptionId   String
  months           Int
  price            Decimal                 @db.Decimal(10, 2)
  currency         String                  @db.VarChar(3) @default("USD")
  label            String?
  validFrom        DateTime?
  validUntil       DateTime?
  subscription     Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  scheduledEntries UserSubscriptionEntry[] @relation("ScheduledPrepay")

  @@map("subscription_prepay_options")
  @@index([subscriptionId])
}

model SubscriptionMonth {
  id             String                  @id @default(uuid())
  subscriptionId String
  year           Int
  month          Int
  theme          String?
  coverImage     String?
  coverImageAssetId String?
  spoilerImage   String?
  spoilerImageAssetId String?
  isSpoiler      Boolean                 @default(false)
  announcedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  actualShipping Decimal?                @db.Decimal(10, 2)
  bookId         String?
  boxPrice       Decimal?                @db.Decimal(10, 2)
  editionId      String?
  seriesId       String?
  signatureType  SignatureType?
  cardArtistId   String?
  books          SubscriptionMonthBook[]
  cardArtist     Artist?                 @relation(fields: [cardArtistId], references: [id])
  series         SubscriptionSeries?     @relation(fields: [seriesId], references: [id])
  subscription   Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  skipRecords    UserSkipRecord[]
  userMonths     UserSubBillingPeriod[]
  coverImageAsset  MediaAsset?           @relation("MonthCover", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  spoilerImageAsset MediaAsset?          @relation("MonthSpoiler", fields: [spoilerImageAssetId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, year, month])
  @@index([subscriptionId])
  @@index([year, month])
  @@map("subscription_months")
}

model SubscriptionMonthBook {
  id            String            @id @default(uuid())
  monthId       String
  bookId        String
  editionId     String?
  isMainBook    Boolean           @default(true)
  sortOrder     Int               @default(0)
  signatureType SignatureType?
  book          Book              @relation(fields: [bookId], references: [id])
  edition       BookEdition?      @relation(fields: [editionId], references: [id])
  month         SubscriptionMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, bookId])
  @@index([bookId])
  @@index([editionId])
  @@map("subscription_month_books")
}

model SaleAnnouncement {
  id                   String                    @id @default(uuid())
  title                String
  companyId            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  basePrice            Decimal?                  @db.Decimal(10, 2)
  subscriberBasePrice  Decimal?                  @db.Decimal(10, 2)
  currency             String?
  extraImagesJson      Json?
  imageUrl             String?
  imageAssetId         String?
  saleTimezone         String?
  availableForPurchase Boolean                   @default(false)
  isBundle             Boolean                   @default(false)
  expectedShipping     String?
  photoCredit          String?
  sourceUrl            String?
  earlyAccessDate      DateTime?
  firstAccessDate      DateTime?
  generalSaleDate      DateTime?
  editions             SaleAnnouncementEdition[]
  regions              SaleAnnouncementRegion[]
  company              BookBoxCompany?           @relation(fields: [companyId], references: [id])
  purchaseGroups       UserPurchaseGroup[]
  interests            UserSaleInterest[]
  imageAsset           MediaAsset?               @relation("SAMainImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  extraImages          SaleAnnouncementMediaAsset[]

  @@index([companyId])
  @@index([generalSaleDate])
  @@index([createdAt])
  @@map("sale_announcements")
}

model SaleAnnouncementEdition {
  id           String                           @id @default(uuid())
  editionId    String
  saleId       String
  sortOrder    Int                              @default(0)
  isReprint    Boolean                          @default(false)
  edition      BookEdition                      @relation(fields: [editionId], references: [id])
  announcement SaleAnnouncement                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variants        SaleAnnouncementEditionVariant[]
  userBookEntries UserBookEntry[]

  @@unique([saleId, editionId])
  @@index([editionId])
  @@map("sale_announcement_editions")
}

model SaleAnnouncementEditionVariant {
  id                        String                  @id @default(uuid())
  saleAnnouncementEditionId String
  signatureType             SignatureType
  price                     Decimal?                @db.Decimal(10, 2)
  currency                  String?                 @db.VarChar(3)
  saleAnnouncementEdition   SaleAnnouncementEdition @relation(fields: [saleAnnouncementEditionId], references: [id], onDelete: Cascade)

  @@unique([saleAnnouncementEditionId, signatureType])
  @@map("sale_announcement_edition_variants")
}

model SaleAnnouncementRegion {
  id              String           @id @default(uuid())
  saleId          String
  name            String
  countryCodes    Json             @default("[]")
  isDefault       Boolean          @default(false)
  generalSaleDate DateTime?
  firstAccessDate DateTime?
  earlyAccessDate DateTime?
  endsAt          DateTime?
  saleTimezone    String?
  basePrice       Decimal?         @db.Decimal(10, 2)
  subscriberBasePrice Decimal?     @db.Decimal(10, 2)
  currency        String?          @db.VarChar(3)
  createdAt       DateTime         @default(now())
  announcement    SaleAnnouncement @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_announcement_regions")
}

model UserSaleInterest {
  userId                String
  announcementId        String
  tier                  String           @default("GS") @db.VarChar(2)
  regionId              String?
  selectedPrice         Decimal?         @db.Decimal(10, 2)
  selectedPriceCurrency String?          @db.VarChar(3)
  createdAt             DateTime         @default(now())
  announcement   SaleAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("user_sale_interests")
}

model UserBookEntry {
  id                    String                 @id @default(uuid())
  userId                String
  bookId                String
  editionId             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  acquiredAt            DateTime?
  addedAt               DateTime               @default(now())
  condition             String?
  isWishlist            Boolean                @default(false)
  ownershipStatus       String                 @default("OWNED")
  readingStatus         String                 @default("UNREAD")
  saleCurrency          String?
  saleDate              String?
  saleNotes             String?
  salePrice             Decimal?               @db.Decimal(10, 2)
  saleVenue             String?
  purchaseGroupId       String?
  subscriptionEntryId   String?
  signatureType              SignatureType?
  orderNumber                String?
  saleAnnouncementEditionId  String?                @db.VarChar(36)
  isOriginalPrint            Boolean                @default(true)
  book                       Book                   @relation(fields: [bookId], references: [id])
  edition                    BookEdition?           @relation(fields: [editionId], references: [id])
  purchaseGroup              UserPurchaseGroup?     @relation(fields: [purchaseGroupId], references: [id])
  subscriptionEntry          UserSubscriptionEntry? @relation(fields: [subscriptionEntryId], references: [id], onDelete: SetNull)
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleAnnouncementEdition    SaleAnnouncementEdition? @relation(fields: [saleAnnouncementEditionId], references: [id], onDelete: SetNull)
  saleEntries                UserSaleEntry[]
  ownershipHistory           OwnershipStatusHistory[]
  readingHistory             ReadingHistory[]
  entryTags                  UserBookEntryTag[]
  trackingNumbers            UserBookEntryTracking[]

  @@index([userId])
  @@index([userId, bookId, editionId])
  @@index([userId, ownershipStatus])
  @@index([userId, readingStatus])
  @@index([userId, ownershipStatus, readingStatus])
  @@index([purchaseGroupId])
  @@index([subscriptionEntryId])
  @@index([editionId])
  @@index([bookId])
  @@index([userId, createdAt])
  @@index([saleAnnouncementEditionId])
  @@map("user_book_entries")
}

model OwnershipStatusHistory {
  id              String        @id @default(uuid())
  userBookEntryId String
  status          String
  changedAt       DateTime      @default(now())
  entry           UserBookEntry @relation(fields: [userBookEntryId], references: [id], onDelete: Cascade)

  @@index([userBookEntryId, changedAt])
  @@map("ownership_status_history")
}

model ReadingHistory {
  id              String        @id @default(uuid())
  userBookEntryId String
  startedAt       DateTime?
  finishedAt      DateTime?
  isDnf           Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  entry           UserBookEntry @relation(fields: [userBookEntryId], references: [id], onDelete: Cascade)

  @@index([userBookEntryId, startedAt])
  @@map("reading_history")
}

