generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                      @id @default(uuid())
  username            String                      @unique
  email               String                      @unique
  emailVerified       Boolean                     @default(false)
  passwordHash        String?
  role                Role                        @default(USER)
  preferredCurrency   String                      @default("EUR")
  avatarUrl           String?
  bio                 String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  managedCompanyId    String?
  timezone            String                      @default("UTC")
  defaultTaxRate      Decimal?                    @db.Decimal(5, 2)
  shippingCountry     String?                     @db.VarChar(2)
  accounts            Account[]
  auditLogs           AuditLog[]
  submittedEditions   BookEdition[]               @relation("SubmittedEditions")
  commentLikes        CommentLike[]
  conversationMembers ConversationMember[]
  editionComments     EditionComment[]
  editionLikes        EditionLike[]
  sentMessages        Message[]                   @relation("SentMessages")
  purchases           PurchaseTransaction[]
  reviewHelpfuls      ReviewHelpful[]
  reviews             Review[]
  sessions            Session[]
  waitlistEntries     SubscriptionWaitlistEntry[]
  bookEntries         UserBookEntry[]
  editionTags         UserEditionTag[]
  favoriteArtists     UserFavoriteArtist[]
  favoriteAuthors     UserFavoriteAuthor[]
  favoriteBooks       UserFavoriteBook[]
  favoriteCompanies   UserFavoriteCompany[]
  favoriteEditions    UserFavoriteEdition[]
  feeTemplates        UserFeeTemplate[]
  following           UserFollow[]                @relation("Follower")
  followers           UserFollow[]                @relation("Following")
  notifications       UserNotification[]
  purchaseDiscounts   UserPurchaseDiscount[]
  purchaseFees        UserPurchaseFee[]
  purchaseGroups      UserPurchaseGroup[]
  purchaseRefunds     UserPurchaseRefund[]
  saleInterests       UserSaleInterest[]
  skipRecords         UserSkipRecord[]
  subEntryTags        UserSubEntryTag[]
  subscriptionEntries UserSubscriptionEntry[]
  bugReports          BugReport[]
  featureRequests     FeatureRequest[]
  featureVotes        FeatureVote[]
  managedCompany      BookBoxCompany?             @relation("CompanyManagers", fields: [managedCompanyId], references: [id])

  @@index([shippingCountry])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id           String  @id @default(uuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Book {
  id           String                  @id @default(uuid())
  slug         String                  @unique
  title        String
  altTitle     String?
  description  String?
  coverImage   String?
  language     String                  @default("en")
  isbn         String?
  seriesName   String?
  volumeNumber Float?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  status       String                  @default("approved")
  genres       String[]
  authors      BookAuthor[]
  editions     BookEdition[]
  reviews      Review[]
  monthBooks   SubscriptionMonthBook[]
  userEntries  UserBookEntry[]
  favoriteBy   UserFavoriteBook[]

  @@index([language])
  @@index([seriesName])
  @@index([status])
  @@map("books")
}

model Author {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  bio         String?
  photoUrl    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  facebook    String?
  instagram   String?
  nationality String?
  tiktok      String?
  twitter     String?
  website     String?
  books       BookAuthor[]
  favoriteBy  UserFavoriteAuthor[]

  @@index([nationality])
  @@map("authors")
}

model BookAuthor {
  bookId   String
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model Artist {
  id            String               @id @default(uuid())
  slug          String               @unique
  name          String
  bio           String?
  photoUrl      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  facebook      String?
  instagram     String?
  specialty     String?
  tiktok        String?
  twitter       String?
  website       String?
  contributions ArtistContribution[]
  favoriteBy    UserFavoriteArtist[]

  @@index([specialty])
  @@map("artists")
}

model ArtistContribution {
  id         String      @id @default(uuid())
  editionId  String
  artistId   String
  role       String      @default("cover")
  artistName String?
  artist     Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  edition    BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, artistId])
  @@map("artist_contributions")
}

model BookEdition {
  id                       String                    @id @default(uuid())
  slug                     String                    @unique
  bookId                   String
  publisher                String?
  publishYear              Int?
  format                   String?
  coverImage               String?
  additionalImages         String[]
  isSpecial                Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  alternativeTitle         String?
  basePrice                Decimal?                  @db.Decimal(10, 2)
  bookBoxCompanyCustomName String?
  bookBoxCompanyId         String?
  collectionId             String?
  currency                 String?
  earlyAccessDate          String?
  editionName              String?
  features                 String[]
  firstAccessDate          String?
  generalSaleDate          String?
  language                 String?
  subscriptionId           String?
  subscriptionMonthId      String?
  submittedByUserId        String?
  verifiedAt               DateTime?
  artists                  ArtistContribution[]
  bookBoxCompany           BookBoxCompany?           @relation(fields: [bookBoxCompanyId], references: [id])
  book                     Book                      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  collection               BookBoxCollection?        @relation(fields: [collectionId], references: [id])
  submittedBy              User?                     @relation("SubmittedEditions", fields: [submittedByUserId], references: [id])
  comments                 EditionComment[]
  likes                    EditionLike[]
  saleEditions             SaleAnnouncementEdition[]
  monthBooks               SubscriptionMonthBook[]
  userEntries              UserBookEntry[]
  tags                     UserEditionTag[]
  favoriteBy               UserFavoriteEdition[]

  @@index([bookId])
  @@index([bookBoxCompanyId])
  @@index([subscriptionId])
  @@index([subscriptionMonthId])
  @@index([language])
  @@index([generalSaleDate])
  @@map("book_editions")
}

model BookBoxCompany {
  id              String                @id @default(uuid())
  slug            String                @unique
  name            String
  description     String?
  logoUrl         String?
  website         String?
  country         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bluesky         String?
  defaultCurrency String?
  facebook        String?
  instagram       String?
  iossImplemented Boolean               @default(false)
  threads         String?
  tiktok          String?
  x               String?
  collections     BookBoxCollection[]
  editions        BookEdition[]
  sponsoredSlots  SponsoredSlot[]
  subscriptions   Subscription[]
  favoriteBy      UserFavoriteCompany[]
  managers        User[]                @relation("CompanyManagers")

  @@index([country])
  @@map("book_box_companies")
}

model BookBoxCollection {
  id          String         @id @default(uuid())
  companyId   String
  name        String
  coverImage  String?
  createdAt   DateTime       @default(now())
  description String?
  isActive    Boolean        @default(true)
  slug        String         @unique
  updatedAt   DateTime       @updatedAt
  company     BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  editions    BookEdition[]

  @@map("book_box_collections")
}

model Subscription {
  id                   String                       @id @default(uuid())
  slug                 String                       @unique
  companyId            String
  name                 String
  description          String?
  coverImage           String?
  genre                String?
  startDate            DateTime?
  endDate              DateTime?
  isDiscontinued       Boolean                      @default(false)
  currency             String                       @default("EUR")
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  bookishMerch         Boolean                      @default(false)
  genres               String[]
  isCombo              Boolean                      @default(false)
  logoUrl              String?
  parentSubscriptionId String?
  renewalDay           Int?
  renewalDayUserSet    Boolean                      @default(false)
  shippingCountries    String[]
  shipsInternationally Boolean                      @default(false)
  startingMonth        Int?
  type                 String?
  language             String?
  price                String?
  contentType          String                       @default("MIX")
  isHidden             Boolean                      @default(false)
  comboComponents      SubscriptionComboComponent[] @relation("SubscriptionAsCombo")
  comboOf              SubscriptionComboComponent[] @relation("SubscriptionAsComponent")
  months               SubscriptionMonth[]
  prepayOptions        SubscriptionPrepayOption[]
  series               SubscriptionSeries[]
  skipPolicy           SubscriptionSkipPolicy?
  waitlistEntries      SubscriptionWaitlistEntry[]
  company              BookBoxCompany               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent               Subscription?                @relation("SubVariants", fields: [parentSubscriptionId], references: [id], onUpdate: NoAction)
  variants             Subscription[]               @relation("SubVariants")
  userEntries          UserSubscriptionEntry[]

  @@index([companyId])
  @@index([isDiscontinued])
  @@index([type])
  @@map("subscriptions")
}

model SubscriptionComboComponent {
  comboId     String
  componentId String
  combo       Subscription @relation("SubscriptionAsCombo", fields: [comboId], references: [id], onDelete: Cascade)
  component   Subscription @relation("SubscriptionAsComponent", fields: [componentId], references: [id], onDelete: Cascade)

  @@id([comboId, componentId])
  @@map("subscription_combo_components")
}

model SubscriptionSkipPolicy {
  subscriptionId         String       @id
  type                   String       @default("NONE")
  maxSkips               Int?
  maxConsecutive         Int?
  windowMonths           Int?
  notes                  String?
  skipDeadlineDaysBefore Int          @default(0)
  subscription           Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_skip_policies")
}

model SubscriptionSeries {
  id              String              @id @default(uuid())
  subscriptionId  String
  slug            String              @unique
  name            String
  description     String?
  coverImage      String?
  startMonth      Int
  startYear       Int
  endMonth        Int
  endYear         Int
  skipMode        String              @default("INDIVIDUAL")
  canCancelDuring Boolean             @default(true)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  months          SubscriptionMonth[]
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  skipRecords     UserSkipRecord[]

  @@index([subscriptionId])
  @@map("subscription_series")
}

model UserSkipRecord {
  id                  String                @id @default(uuid())
  userId              String
  userEntryId         String
  subscriptionMonthId String
  skippedAt           DateTime              @default(now())
  windowKey           String?
  undoneAt            DateTime?
  seriesId            String?
  series              SubscriptionSeries?   @relation(fields: [seriesId], references: [id])
  month               SubscriptionMonth     @relation(fields: [subscriptionMonthId], references: [id], onDelete: Cascade)
  userEntry           UserSubscriptionEntry @relation(fields: [userEntryId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userEntryId, subscriptionMonthId])
  @@index([userEntryId])
  @@index([userId])
  @@map("user_skip_records")
}

model UserSubscriptionSkipState {
  userId           String
  subscriptionId   String
  windowKey        String?
  skipsInWindow    Int       @default(0)
  consecutiveSkips Int       @default(0)
  totalSkips       Int       @default(0)
  lastSkipAt       DateTime?

  @@id([userId, subscriptionId])
  @@map("user_subscription_skip_states")
}

model SubscriptionPrepayOption {
  id             String       @id @default(uuid())
  subscriptionId String
  months         Int
  price          Decimal      @db.Decimal(10, 2)
  label          String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_prepay_options")
}

model SubscriptionMonth {
  id             String                  @id @default(uuid())
  subscriptionId String
  year           Int
  month          Int
  theme          String?
  coverImage     String?
  spoilerImage   String?
  isSpoiler      Boolean                 @default(false)
  announcedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  actualShipping Decimal?                @db.Decimal(10, 2)
  bookId         String?
  boxPrice       Decimal?                @db.Decimal(10, 2)
  editionId      String?
  seriesId       String?
  books          SubscriptionMonthBook[]
  series         SubscriptionSeries?     @relation(fields: [seriesId], references: [id])
  subscription   Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  skipRecords    UserSkipRecord[]
  userMonths     UserSubBillingPeriod[]

  @@unique([subscriptionId, year, month])
  @@index([subscriptionId])
  @@index([year, month])
  @@map("subscription_months")
}

model SubscriptionMonthBook {
  id         String            @id @default(uuid())
  monthId    String
  bookId     String
  editionId  String?
  isMainBook Boolean           @default(true)
  sortOrder  Int               @default(0)
  book       Book              @relation(fields: [bookId], references: [id])
  edition    BookEdition?      @relation(fields: [editionId], references: [id])
  month      SubscriptionMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, bookId])
  @@map("subscription_month_books")
}

model SaleAnnouncement {
  id                   String                    @id @default(uuid())
  title                String
  description          String?
  companyId            String?
  isPublished          Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  basePrice            Decimal?                  @db.Decimal(10, 2)
  currency             String?
  extraImagesJson      String?
  imageUrl             String?
  saleTimezone         String?
  availableForPurchase Boolean                   @default(false)
  isBundle             Boolean                   @default(false)
  earlyAccessDate      DateTime?
  firstAccessDate      DateTime?
  generalSaleDate      DateTime?
  editions             SaleAnnouncementEdition[]
  purchaseGroups       UserPurchaseGroup[]
  interests            UserSaleInterest[]

  @@index([isPublished])
  @@index([companyId])
  @@index([generalSaleDate])
  @@map("sale_announcements")
}

model SaleAnnouncementEdition {
  id           String           @id @default(uuid())
  editionId    String
  saleId       String
  sortOrder    Int              @default(0)
  edition      BookEdition      @relation(fields: [editionId], references: [id])
  announcement SaleAnnouncement @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, editionId])
  @@map("sale_announcement_editions")
}

model UserSaleInterest {
  userId         String
  announcementId String
  createdAt      DateTime         @default(now())
  announcement   SaleAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("user_sale_interests")
}

model UserBookEntry {
  id                    String                 @id @default(uuid())
  userId                String
  bookId                String
  editionId             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  acquiredAt            DateTime?
  addedAt               DateTime               @default(now())
  allocatedPrice        Decimal?               @db.Decimal(10, 2)
  condition             String?
  isWishlist            Boolean                @default(false)
  ownershipStatus       String                 @default("OWNED")
  purchaseDate          DateTime?
  purchaseTransactionId String?
  readingStatus         String                 @default("UNREAD")
  priceCurrency         String?                @db.VarChar(3)
  saleCurrency          String?
  saleDate              String?
  saleNotes             String?
  salePrice             Decimal?               @db.Decimal(10, 2)
  saleVenue             String?
  purchaseGroupId       String?
  subscriptionEntryId   String?
  book                  Book                   @relation(fields: [bookId], references: [id])
  edition               BookEdition?           @relation(fields: [editionId], references: [id])
  purchaseGroup         UserPurchaseGroup?     @relation(fields: [purchaseGroupId], references: [id])
  subscriptionEntry     UserSubscriptionEntry? @relation(fields: [subscriptionEntryId], references: [id], onDelete: SetNull)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseDiscounts     UserPurchaseDiscount[]
  purchaseFees          UserPurchaseFee[]
  purchaseRefunds       UserPurchaseRefund[]

  @@unique([userId, bookId, editionId])
  @@index([userId])
  @@index([userId, ownershipStatus])
  @@index([userId, readingStatus])
  @@index([purchaseGroupId])
  @@map("user_book_entries")
}

model UserSubscriptionEntry {
  id                 String                             @id @default(uuid())
  userId             String
  subscriptionId     String
  startDate          String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  active             Boolean                            @default(true)
  addedAt            DateTime                           @default(now())
  cancellationDate   String?
  companyId          String?
  firstSkipDate      DateTime?
  renewalDay         Int?
  shippingCost       Decimal?                           @db.Decimal(10, 2)
  startingMonth      Int?
  taxesAndFees       Decimal?                           @db.Decimal(10, 2)
  nextRenewalDate    DateTime?
  prepaidMonths      Int                                @default(1)
  costCurrency       String?
  basePrice          Decimal?                           @db.Decimal(10, 2)
  cancellationReason String?
  shippingCountry    String?                            @db.VarChar(2)
  skipRecords        UserSkipRecord[]
  billingPeriods     UserSubBillingPeriod[]
  tags               UserSubEntryTag[]
  costChanges        UserSubscriptionCostChange[]
  bookEntries        UserBookEntry[]
  subscription       Subscription                       @relation(fields: [subscriptionId], references: [id])
  user               User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeTemplates       UserSubscriptionEntryFeeTemplate[]

  @@unique([userId, subscriptionId])
  @@index([userId])
  @@index([userId, active])
  @@index([subscriptionId, shippingCountry])
  @@map("user_subscription_entries")
}

model UserSubBillingPeriod {
  id                    String                 @id @default(uuid())
  entryId               String
  monthId               String?
  baseAmount            Decimal?               @db.Decimal(10, 2)
  coveredFromMonth      Int                    @default(0)
  coveredFromYear       Int                    @default(0)
  monthsCovered         Int                    @default(1)
  notes                 String?
  prepayOptionId        String?
  purchaseTransactionId String?
  shipping              Decimal?               @db.Decimal(10, 2)
  taxesAndFees          Decimal?               @db.Decimal(10, 2)
  coveredToMonth        Int?
  coveredToYear         Int?
  paidCurrency          String?
  billedAt              DateTime?
  purchaseDiscounts     UserPurchaseDiscount[]
  purchaseFees          UserPurchaseFee[]
  purchaseRefunds       UserPurchaseRefund[]
  entry                 UserSubscriptionEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  month                 SubscriptionMonth?     @relation(fields: [monthId], references: [id])

  @@map("user_sub_billing_periods")
}

model UserSubscriptionCostChange {
  id                 String                @id @default(uuid())
  entryId            String
  effectiveFromMonth Int
  effectiveFromYear  Int
  recordedAt         DateTime              @default(now())
  shippingCost       Decimal?              @db.Decimal(10, 2)
  taxesAndFees       Decimal?              @db.Decimal(10, 2)
  entry              UserSubscriptionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("user_subscription_cost_changes")
}

model PurchaseTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String
  description String?
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchase_transactions")
}

model UserFavoriteBook {
  userId String
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@map("user_favorite_books")
}

model UserFavoriteAuthor {
  userId   String
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, authorId])
  @@map("user_favorite_authors")
}

model UserFavoriteArtist {
  userId   String
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("user_favorite_artists")
}

model UserFavoriteEdition {
  userId    String
  editionId String
  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@map("user_favorite_editions")
}

model UserFavoriteCompany {
  userId    String
  companyId String
  company   BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_favorite_companies")
}

model UserEditionTag {
  id        String      @id @default(uuid())
  userId    String
  editionId String
  tag       String
  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId, tag])
  @@map("user_edition_tags")
}

model UserSubEntryTag {
  id      String                @id @default(uuid())
  userId  String
  entryId String
  tag     String
  entry   UserSubscriptionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, tag])
  @@map("user_sub_entry_tags")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model Review {
  id                 String          @id @default(uuid())
  userId             String
  bookId             String
  rating             Int
  title              String?
  body               String
  containsSpoilers   Boolean         @default(false)
  isVerifiedPurchase Boolean         @default(false)
  helpfulCount       Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  helpful            ReviewHelpful[]
  book               Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reviews")
}

model ReviewHelpful {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_helpfuls")
}

model EditionLike {
  userId    String
  editionId String
  createdAt DateTime    @default(now())
  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@map("edition_likes")
}

model EditionComment {
  id        String        @id @default(uuid())
  userId    String
  editionId String
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likes     CommentLike[]
  edition   BookEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("edition_comments")
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime       @default(now())
  comment   EditionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_likes")
}

model Conversation {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  payload   Json?
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}

model SponsoredSlot {
  id        String            @id @default(uuid())
  companyId String
  type      SponsoredSlotType
  startsAt  DateTime
  endsAt    DateTime
  priceEur  Float
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   BookBoxCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sponsored_slots")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model ExchangeRateCache {
  id           String   @id @default(uuid())
  rate         Decimal  @db.Decimal(18, 6)
  fetchedAt    DateTime @default(now())
  fromCurrency String
  toCurrency   String

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rate_cache")
}

model ExchangeRateHistory {
  id           String   @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 6)
  date         DateTime @db.Date
  fetchedAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency, toCurrency, date])
  @@map("exchange_rate_history")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  username    String?
  action      String
  entityType  String
  entityId    String?
  entityTitle String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  description String
  pageUrl     String?
  category    String   @default("general") @db.VarChar(50)
  status      String   @default("open") @db.VarChar(20)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("bug_reports")
}

model FeatureRequest {
  id          String         @id @default(uuid())
  title       String
  description String
  status      String         @default("pending") @db.VarChar(20)
  adminNote   String?
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes       FeatureVote[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("feature_requests")
}

model FeatureVote {
  id               String         @id @default(uuid())
  featureRequestId String
  userId           String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([featureRequestId, userId])
  @@map("feature_votes")
}

/// Reusable fee templates defined by the user (e.g. "Polish Customs VAT", "DHL Processing Fee")
model UserFeeTemplate {
  id                  String                             @id @default(uuid())
  userId              String
  name                String
  category            FeeCategory                        @default(OTHER)
  defaultAmount       Decimal?                           @db.Decimal(10, 2)
  defaultCurrency     String                             @default("PLN")
  isActive            Boolean                            @default(true)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  user                User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseFees        UserPurchaseFee[]
  subscriptionEntries UserSubscriptionEntryFeeTemplate[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("user_fee_templates")
}

/// Links a fee template to a subscription entry — these templates auto-apply on each billing period
model UserSubscriptionEntryFeeTemplate {
  subscriptionEntryId String
  feeTemplateId       String
  /// Optional per-subscription override amount (if null, uses template's defaultAmount)
  customAmount        Decimal?              @db.Decimal(10, 2)
  createdAt           DateTime              @default(now())
  /// Optional per-subscription override currency (if null, uses template's defaultCurrency)
  customCurrency      String?
  feeTemplate         UserFeeTemplate       @relation(fields: [feeTemplateId], references: [id], onDelete: Cascade)
  entry               UserSubscriptionEntry @relation(fields: [subscriptionEntryId], references: [id], onDelete: Cascade)

  @@id([subscriptionEntryId, feeTemplateId])
  @@index([subscriptionEntryId])
  @@map("user_subscription_entry_fee_templates")
}

/// Individual fee/tax instance linked to a billing period or book entry
model UserPurchaseFee {
  id              String                @id @default(uuid())
  userId          String
  feeTemplateId   String?
  name            String
  amount          Decimal               @db.Decimal(10, 2)
  currency        String
  date            DateTime              @db.Date
  category        FeeCategory           @default(OTHER)
  billingPeriodId String?
  userBookEntryId String?
  notes           String?
  createdAt       DateTime              @default(now())
  purchaseGroupId String?
  billingPeriod   UserSubBillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  feeTemplate     UserFeeTemplate?      @relation(fields: [feeTemplateId], references: [id])
  purchaseGroup   UserPurchaseGroup?    @relation(fields: [purchaseGroupId], references: [id], onDelete: Cascade)
  userBookEntry   UserBookEntry?        @relation(fields: [userBookEntryId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([billingPeriodId])
  @@index([userBookEntryId])
  @@index([purchaseGroupId])
  @@map("user_purchase_fees")
}

/// One-off discount applied to a billing period or book entry at purchase time
model UserPurchaseDiscount {
  id              String                @id @default(uuid())
  userId          String
  name            String
  amount          Decimal               @db.Decimal(10, 2)
  currency        String
  date            DateTime              @db.Date
  billingPeriodId String?
  userBookEntryId String?
  notes           String?
  createdAt       DateTime              @default(now())
  purchaseGroupId String?
  billingPeriod   UserSubBillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  purchaseGroup   UserPurchaseGroup?    @relation(fields: [purchaseGroupId], references: [id], onDelete: Cascade)
  userBookEntry   UserBookEntry?        @relation(fields: [userBookEntryId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([billingPeriodId])
  @@index([userBookEntryId])
  @@index([purchaseGroupId])
  @@map("user_purchase_discounts")
}

model UserPurchaseRefund {
  id              String                @id @default(uuid())
  userId          String
  amount          Decimal               @db.Decimal(10, 2)
  currency        String
  date            DateTime              @db.Date
  billingPeriodId String?
  userBookEntryId String?
  reason          String?
  notes           String?
  createdAt       DateTime              @default(now())
  purchaseGroupId String?
  billingPeriod   UserSubBillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  purchaseGroup   UserPurchaseGroup?    @relation(fields: [purchaseGroupId], references: [id], onDelete: Cascade)
  userBookEntry   UserBookEntry?        @relation(fields: [userBookEntryId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([billingPeriodId])
  @@index([userBookEntryId])
  @@index([purchaseGroupId])
  @@map("user_purchase_refunds")
}

model UserPurchaseGroup {
  id                 String                 @id @default(uuid())
  userId             String
  saleAnnouncementId String?
  title              String?
  totalAmount        Decimal                @db.Decimal(10, 2)
  currency           String
  shippingAmount     Decimal?               @db.Decimal(10, 2)
  purchasedAt        DateTime
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  bookEntries        UserBookEntry[]
  discounts          UserPurchaseDiscount[]
  fees               UserPurchaseFee[]
  saleAnnouncement   SaleAnnouncement?      @relation(fields: [saleAnnouncementId], references: [id])
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds            UserPurchaseRefund[]

  @@index([userId])
  @@index([userId, purchasedAt])
  @@index([saleAnnouncementId])
  @@map("user_purchase_groups")
}

model SubscriptionWaitlistEntry {
  id             String       @id @default(uuid())
  userId         String
  subscriptionId String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subscriptionId])
  @@index([userId])
  @@index([subscriptionId])
  @@map("subscription_waitlist_entries")
}

enum Role {
  ADMIN
  MODERATOR
  USER
  COMPANY_MANAGER
}

enum SponsoredSlotType {
  HOMEPAGE_FEATURED
  COMPANY_PAGE_BANNER
  NEWSLETTER_SLOT
}

enum FeeCategory {
  VAT
  CUSTOMS
  SHIPPING
  PROCESSING
  FORWARDING
  OTHER
}
