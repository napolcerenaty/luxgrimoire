  includePatterns Json     @default("[]")
  excludePatterns Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([group])
  @@map("feature_categories")
}

model EditionFeatureTag {
  id         String      @id @default(uuid())
  editionId  String
  rawValue   String
  categories String[]    @default([])
  isManual   Boolean     @default(false) @map("is_manual")
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  edition    BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, rawValue])
  @@index([editionId])
  @@index([editionId, sortOrder])
  @@map("edition_feature_tags")
}

// ─── Media Asset Library ──────────────────────────────────────────────────────

model MediaAsset {
  id           String   @id @default(uuid())
  publicId     String   @unique
  folder       String?
  createdAt    DateTime @default(now())
  uploadedById String?
  uploadedBy   User?    @relation("MediaAssetUploads", fields: [uploadedById], references: [id], onDelete: SetNull)

  // Back-relations from all models that reference this asset
  authorPhotos         Author[]                     @relation("AuthorPhoto")
  artistPhotos         Artist[]                     @relation("ArtistPhoto")
  companyLogos         BookBoxCompany[]              @relation("CompanyLogo")
  subscriptionCovers   Subscription[]               @relation("SubscriptionCover")
  subscriptionLogos    Subscription[]               @relation("SubscriptionLogo")
  seriesCovers         SubscriptionSeries[]         @relation("SeriesCover")
  monthCovers          SubscriptionMonth[]          @relation("MonthCover")
  monthSpoilers        SubscriptionMonth[]          @relation("MonthSpoiler")
  saMainImages         SaleAnnouncement[]           @relation("SAMainImage")
  editionImages        BookEditionMediaAsset[]
  saExtraImages        SaleAnnouncementMediaAsset[]

  @@index([uploadedById])
  @@map("media_assets")
}

model BookEditionMediaAsset {
  editionId String
  assetId   String
  sortOrder Int         @default(0)
  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  asset     MediaAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([editionId, assetId])
  @@index([assetId])
  @@map("book_edition_media_assets")
}

model SaleAnnouncementMediaAsset {
  announcementId String
  assetId        String
  sortOrder      Int              @default(0)
  announcement   SaleAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  asset          MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([announcementId, assetId])
  @@index([assetId])
  @@map("sale_announcement_media_assets")
}

model HomepageFeature {
  id          String   @id @default(uuid())
  title       String
  description String
  iconName    String   @default("Star")
  ctaLabel    String?
  ctaHref     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("homepage_features")
}
