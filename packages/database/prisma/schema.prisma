// LuxGrimoire — Prisma Schema
// Note: All IDs use @default(uuid()) which generates UUID v4.
// Upgrading to UUIDv7 requires the pg_uuidv7 PostgreSQL extension.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MODERATOR
  COMPANY_MANAGER
  USER
}

enum SponsoredSlotType {
  HOMEPAGE_FEATURED
  COMPANY_PAGE_BANNER
  NEWSLETTER_SLOT
}

// ─────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  emailVerified     Boolean  @default(false)
  passwordHash      String?
  role              Role     @default(USER)
  managedCompanyId  String?
  preferredCurrency String   @default("EUR")
  timezone          String   @default("UTC")
  defaultTaxRate    Decimal? @db.Decimal(5, 2) // user's default tax/VAT rate as a percentage (e.g. 21.00)
  avatarUrl         String?
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  bookEntries         UserBookEntry[]
  subscriptionEntries UserSubscriptionEntry[]
  purchases           PurchaseTransaction[]
  favoriteBooks       UserFavoriteBook[]
  favoriteAuthors     UserFavoriteAuthor[]
  favoriteArtists     UserFavoriteArtist[]
  favoriteEditions    UserFavoriteEdition[]
  favoriteCompanies   UserFavoriteCompany[]
  notifications       UserNotification[]
  sentMessages        Message[]               @relation("SentMessages")
  conversationMembers ConversationMember[]
  following           UserFollow[]            @relation("Follower")
  followers           UserFollow[]            @relation("Following")
  editionTags         UserEditionTag[]
  subEntryTags        UserSubEntryTag[]
  editionLikes        EditionLike[]
  editionComments     EditionComment[]
  commentLikes        CommentLike[]
  saleInterests       UserSaleInterest[]
  reviews             Review[]
  reviewHelpfuls      ReviewHelpful[]
  auditLogs           AuditLog[]
  managedCompany      BookBoxCompany?         @relation("CompanyManagers", fields: [managedCompanyId], references: [id])
  skipRecords         UserSkipRecord[]
  submittedEditions   BookEdition[]           @relation("SubmittedEditions")
  feeTemplates        UserFeeTemplate[]
  purchaseFees        UserPurchaseFee[]
  purchaseDiscounts   UserPurchaseDiscount[]
  purchaseRefunds     UserPurchaseRefund[]
  purchaseGroups      UserPurchaseGroup[]
  waitlistEntries     SubscriptionWaitlistEntry[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id           String  @id @default(uuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// BOOKS & CATALOGUE
// ─────────────────────────────────────────────

model Book {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  altTitle     String?
  description  String?
  coverImage   String? // Cloudinary public_id
  language     String   @default("en")
  isbn         String?
  seriesName   String?
  volumeNumber Float?
  genres       String[]
  status       String   @default("approved")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authors     BookAuthor[]
  editions    BookEdition[]
  monthBooks  SubscriptionMonthBook[]
  userEntries UserBookEntry[]
  favoriteBy  UserFavoriteBook[]
  reviews     Review[]

  @@index([language])
  @@index([seriesName])
  @@index([status])
  @@map("books")
}

model Author {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  bio         String?
  photoUrl    String? // Cloudinary public_id
  nationality String?
  website     String?
  instagram   String?
  twitter     String?
  facebook    String?
  tiktok      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books      BookAuthor[]
  favoriteBy UserFavoriteAuthor[]

  @@index([nationality])
  @@map("authors")
}

model BookAuthor {
  bookId   String
  authorId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model Artist {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  bio       String?
  photoUrl  String? // Cloudinary public_id
  specialty String?
  website   String?
  instagram String?
  twitter   String?
  facebook  String?
  tiktok    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions ArtistContribution[]
  favoriteBy    UserFavoriteArtist[]

  @@index([specialty])
  @@map("artists")
}

model ArtistContribution {
  id         String  @id @default(uuid())
  editionId  String
  artistId   String
  artistName String?
  role       String  @default("cover")

  edition BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  artist  Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([editionId, artistId])
  @@map("artist_contributions")
}

model BookEdition {
  id                       String   @id @default(uuid())
  slug                     String   @unique
  bookId                   String
  editionName              String?
  publisher                String?
  language                 String?
  alternativeTitle         String?
  publishYear              Int?
  format                   String?
  coverImage               String? // Cloudinary public_id
  additionalImages         String[] // Cloudinary public_ids
  isSpecial                Boolean  @default(false)
  basePrice                Decimal? @db.Decimal(10, 2)
  currency                 String?
  firstAccessDate          String?
  earlyAccessDate          String?
  generalSaleDate          String?
  bookBoxCompanyId         String?
  bookBoxCompanyCustomName String?
  subscriptionId           String?
  subscriptionMonthId      String?
  collectionId             String?
  features                 String[]
  verifiedAt               DateTime?
  submittedByUserId        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  book         Book                      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookBoxCompany BookBoxCompany?         @relation(fields: [bookBoxCompanyId], references: [id])
  collection   BookBoxCollection?        @relation(fields: [collectionId], references: [id])
  submittedBy  User?                     @relation("SubmittedEditions", fields: [submittedByUserId], references: [id])
  artists      ArtistContribution[]
  monthBooks   SubscriptionMonthBook[]
  userEntries  UserBookEntry[]
  favoriteBy   UserFavoriteEdition[]
  tags         UserEditionTag[]
  likes        EditionLike[]
  comments     EditionComment[]
  saleEditions SaleAnnouncementEdition[]

  @@index([bookId])
  @@index([bookBoxCompanyId])
  @@index([subscriptionId])
  @@index([subscriptionMonthId])
  @@index([language])
  @@index([generalSaleDate])
  @@map("book_editions")
}

// ─────────────────────────────────────────────
// BOX COMPANIES & SUBSCRIPTIONS
// ─────────────────────────────────────────────

model BookBoxCompany {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  logoUrl         String? // Cloudinary public_id
  website         String?
  country         String?
  defaultCurrency String?
  instagram       String?
  threads         String?
  tiktok          String?
  facebook        String?
  x               String?
  bluesky         String?
  iossImplemented Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions  Subscription[]
  editions       BookEdition[]
  favoriteBy     UserFavoriteCompany[]
  sponsoredSlots SponsoredSlot[]
  collections    BookBoxCollection[]
  managers       User[]                @relation("CompanyManagers")

  @@index([country])
  @@map("book_box_companies")
}

model BookBoxCollection {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  slug        String   @unique
  description String?
  coverImage  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  editions BookEdition[]

  @@map("book_box_collections")
}

model Subscription {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  companyId            String
  name                 String
  description          String?
  coverImage           String? // Cloudinary public_id
  logoUrl              String?
  genre                String?
  genres               String[]
  startDate            DateTime?
  endDate              DateTime?
  isDiscontinued       Boolean   @default(false)
  isHidden             Boolean   @default(false)
  currency             String    @default("EUR")
  price                String?
  language             String?
  shipsInternationally Boolean   @default(false)
  type                 String?
  contentType          String    @default("MIX")
  bookishMerch         Boolean   @default(false)

  isCombo              Boolean   @default(false)
  parentSubscriptionId String?
  renewalDay           Int?
  renewalDayUserSet    Boolean   @default(false)
  startingMonth        Int?
  shippingCountries    String[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company         BookBoxCompany               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent          Subscription?                @relation("SubVariants", fields: [parentSubscriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  variants        Subscription[]               @relation("SubVariants")
  months          SubscriptionMonth[]
  series          SubscriptionSeries[]
  userEntries     UserSubscriptionEntry[]
  prepayOptions   SubscriptionPrepayOption[]
  comboComponents SubscriptionComboComponent[] @relation("SubscriptionAsCombo")
  comboOf         SubscriptionComboComponent[] @relation("SubscriptionAsComponent")
  skipPolicy      SubscriptionSkipPolicy?
  waitlistEntries SubscriptionWaitlistEntry[]

  @@index([companyId])
  @@index([isDiscontinued])
  @@index([type])
  @@map("subscriptions")
}

model SubscriptionComboComponent {
  comboId     String
  componentId String

  combo     Subscription @relation("SubscriptionAsCombo", fields: [comboId], references: [id], onDelete: Cascade)
  component Subscription @relation("SubscriptionAsComponent", fields: [componentId], references: [id], onDelete: Cascade)

  @@id([comboId, componentId])
  @@map("subscription_combo_components")
}

model SubscriptionSkipPolicy {
  subscriptionId String  @id
  // Policy types (String for extensibility without migrations):
  // NONE | UNLIMITED | UNLIMITED_MAX_CONSECUTIVE | CALENDAR_YEAR | FROM_FIRST_SKIP | FROM_SUB_START
  type           String  @default("NONE")
  maxSkips       Int?    // max skips allowed in the window (null = unlimited)
  maxConsecutive Int?    // max consecutive skips (for UNLIMITED_MAX_CONSECUTIVE)
  windowMonths   Int?    // window length in months (for FROM_FIRST_SKIP, FROM_SUB_START)
  // Skip deadline: N days before the renewal date of the month being skipped (0 = day of renewal)
  skipDeadlineDaysBefore Int @default(0)
  notes          String? // human-readable description for users
  // TODO: Add canUndoSkip Boolean @default(false) when skip reversal policy is defined

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_skip_policies")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION SERIES
// ─────────────────────────────────────────────
// A series groups consecutive months under a named commitment window.
// skipMode:
//   INDIVIDUAL  – each month in the series can be skipped independently
//   SERIES_ONLY – the entire series must be skipped as a single action (1 skip unit)
// canCancelDuring – when true, users cannot cancel their subscription while the series is active

model SubscriptionSeries {
  id              String   @id @default(uuid())
  subscriptionId  String
  slug            String   @unique
  name            String
  description     String?
  coverImage      String?  // Cloudinary public_id
  startMonth      Int      // 1–12
  startYear       Int
  endMonth        Int
  endYear         Int
  // INDIVIDUAL | SERIES_ONLY
  skipMode        String   @default("INDIVIDUAL")
  canCancelDuring Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  months       SubscriptionMonth[]
  skipRecords  UserSkipRecord[]

  @@index([subscriptionId])
  @@map("subscription_series")
}

model UserSkipRecord {
  id                  String    @id @default(uuid())
  userId              String
  userEntryId         String
  subscriptionMonthId String
  seriesId            String?   // set when skip was triggered via series skip endpoint
  skippedAt           DateTime  @default(now())
  windowKey           String? // "2024" for calendar year, "2024-03-15" for from-first-skip, etc.
  undoneAt            DateTime? // TODO: populate when skip reversal is implemented

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEntry UserSubscriptionEntry @relation(fields: [userEntryId], references: [id], onDelete: Cascade)
  month    SubscriptionMonth     @relation(fields: [subscriptionMonthId], references: [id], onDelete: Cascade)
  series   SubscriptionSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@unique([userEntryId, subscriptionMonthId])
  @@index([userEntryId])
  @@index([userId])
  @@map("user_skip_records")
}

model UserSubscriptionSkipState {
  userId           String
  subscriptionId   String
  windowKey        String?
  skipsInWindow    Int      @default(0)
  consecutiveSkips Int      @default(0)
  totalSkips       Int      @default(0)
  lastSkipAt       DateTime?

  @@id([userId, subscriptionId])
  @@map("user_subscription_skip_states")
}

model SubscriptionPrepayOption {
  id             String  @id @default(uuid())
  subscriptionId String
  months         Int
  price          Decimal @db.Decimal(10, 2)
  label          String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_prepay_options")
}

model SubscriptionMonth {
  id             String    @id @default(uuid())
  subscriptionId String
  year           Int
  month          Int // 1-12
  seriesId       String?
  theme          String?
  coverImage     String? // Cloudinary public_id
  spoilerImage   String?
  isSpoiler      Boolean   @default(false)
  announcedAt    DateTime?
  actualShipping Decimal?  @db.Decimal(10, 2)
  boxPrice       Decimal?  @db.Decimal(10, 2)
  bookId         String?
  editionId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  series       SubscriptionSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  books        SubscriptionMonthBook[]
  userMonths   UserSubBillingPeriod[]
  skipRecords  UserSkipRecord[]

  @@unique([subscriptionId, year, month])
  @@index([subscriptionId])
  @@index([year, month])
  @@map("subscription_months")
}

model SubscriptionMonthBook {
  id         String  @id @default(uuid())
  monthId    String
  bookId     String
  editionId  String?
  isMainBook Boolean @default(true)
  sortOrder  Int     @default(0)

  month   SubscriptionMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  book    Book              @relation(fields: [bookId], references: [id])
  edition BookEdition?      @relation(fields: [editionId], references: [id])

  @@unique([monthId, bookId])
  @@map("subscription_month_books")
}

// ─────────────────────────────────────────────
// SALE ANNOUNCEMENTS
// ─────────────────────────────────────────────

model SaleAnnouncement {
  id                   String    @id @default(uuid())
  title                String
  companyId            String?
  generalSaleDate      DateTime?
  firstAccessDate      DateTime?
  earlyAccessDate      DateTime?
  saleTimezone         String?
  basePrice            Decimal?  @db.Decimal(10, 2)
  currency             String?
  description          String?
  imageUrl             String?
  extraImagesJson      String?
  isPublished          Boolean   @default(false)
  isBundle             Boolean   @default(false)
  availableForPurchase Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  editions       SaleAnnouncementEdition[]
  interests      UserSaleInterest[]
  purchaseGroups UserPurchaseGroup[]

  @@index([isPublished])
  @@index([companyId])
  @@index([generalSaleDate])
  @@map("sale_announcements")
}

model SaleAnnouncementEdition {
  id        String @id @default(uuid())
  saleId    String
  editionId String
  sortOrder Int    @default(0)

  announcement SaleAnnouncement @relation(fields: [saleId], references: [id], onDelete: Cascade)
  edition      BookEdition      @relation(fields: [editionId], references: [id])

  @@unique([saleId, editionId])
  @@map("sale_announcement_editions")
}

model UserSaleInterest {
  userId         String
  announcementId String
  createdAt      DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement SaleAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("user_sale_interests")
}

// ─────────────────────────────────────────────
// USER COLLECTION
// ─────────────────────────────────────────────

model UserBookEntry {
  id                    String    @id @default(uuid())
  userId                String
  bookId                String
  editionId             String?
  addedAt               DateTime  @default(now())
  purchaseGroupId       String?
  purchaseTransactionId String?
  allocatedPrice        Decimal?  @db.Decimal(10, 2)
  condition             String?
  purchaseDate          DateTime?
  ownershipStatus       String    @default("OWNED")
  saleDate              String?
  salePrice             Decimal?  @db.Decimal(10, 2)
  saleCurrency          String?
  saleVenue             String?
  saleNotes             String?
  readingStatus         String    @default("UNREAD")
  acquiredAt            DateTime?
  isWishlist            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book               @relation(fields: [bookId], references: [id])
  edition       BookEdition?       @relation(fields: [editionId], references: [id])
  purchaseGroup UserPurchaseGroup? @relation(fields: [purchaseGroupId], references: [id], onDelete: SetNull)
  purchaseFees      UserPurchaseFee[]
  purchaseDiscounts UserPurchaseDiscount[]
  purchaseRefunds   UserPurchaseRefund[]

  @@unique([userId, bookId, editionId])
  @@index([userId])
  @@index([userId, ownershipStatus])
  @@index([userId, readingStatus])
  @@index([purchaseGroupId])
  @@map("user_book_entries")
}

model UserSubscriptionEntry {
  id               String    @id @default(uuid())
  userId           String
  subscriptionId   String
  companyId        String?
  addedAt          DateTime  @default(now())
  startDate        String?
  startingMonth    Int?
  shippingCost     Decimal?  @db.Decimal(10, 2)
  basePrice        Decimal?  @db.Decimal(10, 2) // user's own base price (may differ from subscription's advertised price)
  taxesAndFees     Decimal?  @db.Decimal(10, 2)
  active           Boolean   @default(true)
  renewalDay       Int?
  cancellationDate   String?
  cancellationReason String?
  firstSkipDate      DateTime?
  prepaidMonths    Int       @default(1)
  nextRenewalDate  DateTime?
  costCurrency     String?   // currency for shippingCost + taxesAndFees (defaults to subscription currency)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription                 @relation(fields: [subscriptionId], references: [id])
  billingPeriods UserSubBillingPeriod[]
  tags           UserSubEntryTag[]
  costChanges    UserSubscriptionCostChange[]
  skipRecords    UserSkipRecord[]
  feeTemplates   UserSubscriptionEntryFeeTemplate[]

  @@unique([userId, subscriptionId])
  @@index([userId])
  @@index([userId, active])
  @@map("user_subscription_entries")
}

model UserSubBillingPeriod {
  id                    String    @id @default(uuid())
  entryId               String
  billedAt              DateTime?
  baseAmount            Decimal?  @db.Decimal(10, 2)
  taxesAndFees          Decimal?  @db.Decimal(10, 2)
  shipping              Decimal?  @db.Decimal(10, 2)
  purchaseTransactionId String?
  monthsCovered         Int       @default(1)
  coveredFromMonth      Int       @default(0)
  coveredFromYear       Int       @default(0)
  coveredToMonth        Int?
  coveredToYear         Int?
  paidCurrency          String?
  prepayOptionId        String?
  notes                 String?
  monthId               String?

  entry UserSubscriptionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  month SubscriptionMonth?    @relation(fields: [monthId], references: [id])
  purchaseFees      UserPurchaseFee[]
  purchaseDiscounts UserPurchaseDiscount[]
  purchaseRefunds   UserPurchaseRefund[]

  @@map("user_sub_billing_periods")
}

model UserSubscriptionCostChange {
  id                 String   @id @default(uuid())
  entryId            String
  effectiveFromMonth Int
  effectiveFromYear  Int
  shippingCost       Decimal? @db.Decimal(10, 2)
  taxesAndFees       Decimal? @db.Decimal(10, 2)
  recordedAt         DateTime @default(now())

  entry UserSubscriptionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("user_subscription_cost_changes")
}

model PurchaseTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String
  description String?
  purchasedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchase_transactions")
}

// ─────────────────────────────────────────────
// FAVORITES & TAGS
// ─────────────────────────────────────────────

model UserFavoriteBook {
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@map("user_favorite_books")
}

model UserFavoriteAuthor {
  userId   String
  authorId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([userId, authorId])
  @@map("user_favorite_authors")
}

model UserFavoriteArtist {
  userId   String
  artistId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("user_favorite_artists")
}

model UserFavoriteEdition {
  userId    String
  editionId String

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@map("user_favorite_editions")
}

model UserFavoriteCompany {
  userId    String
  companyId String

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_favorite_companies")
}

model UserEditionTag {
  id        String @id @default(uuid())
  userId    String
  editionId String
  tag       String

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId, tag])
  @@map("user_edition_tags")
}

model UserSubEntryTag {
  id      String @id @default(uuid())
  userId  String
  entryId String
  tag     String

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry UserSubscriptionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, tag])
  @@map("user_sub_entry_tags")
}

// ─────────────────────────────────────────────
// SOCIAL
// ─────────────────────────────────────────────

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  bookId             String
  rating             Int
  title              String?
  body               String
  containsSpoilers   Boolean  @default(false)
  isVerifiedPurchase Boolean  @default(false)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  helpful ReviewHelpful[]

  @@unique([userId, bookId])
  @@map("reviews")
}

model ReviewHelpful {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_helpfuls")
}

model EditionLike {
  userId    String
  editionId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@map("edition_likes")
}

model EditionComment {
  id        String   @id @default(uuid())
  userId    String
  editionId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition BookEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@map("edition_comments")
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment EditionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_likes")
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  payload   Json?
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}

// ─────────────────────────────────────────────
// MONETISATION
// ─────────────────────────────────────────────

model SponsoredSlot {
  id        String            @id @default(uuid())
  companyId String
  type      SponsoredSlotType
  startsAt  DateTime
  endsAt    DateTime
  priceEur  Float
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company BookBoxCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sponsored_slots")
