# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the NestJS API in a pnpm monorepo.
# Build context: repository root (so all packages are accessible).

# ── Stage 1: Install all dependencies ────────────────────────────────────────
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Copy manifests only — maximises layer cache on code-only changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json                   ./apps/api/
COPY packages/database/package.json          ./packages/database/
COPY packages/shared-types/package.json      ./packages/shared-types/

RUN pnpm install --frozen-lockfile

# ── Stage 2: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

COPY --from=deps /app/node_modules            ./node_modules
COPY --from=deps /app/apps/api/node_modules   ./apps/api/node_modules
COPY --from=deps /app/packages/database/node_modules   ./packages/database/node_modules
COPY --from=deps /app/packages/shared-types/node_modules ./packages/shared-types/node_modules

COPY tsconfig.base.json ./
COPY packages/database  ./packages/database
COPY packages/shared-types ./packages/shared-types
COPY apps/api           ./apps/api

# Generate Prisma client
RUN pnpm --filter @luxgrimoire/database db:generate

# Compile NestJS
RUN pnpm --filter @luxgrimoire/api build

# ── Stage 3: Production runtime ───────────────────────────────────────────────
FROM node:20-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

ENV NODE_ENV=production

# Install production deps only
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json                   ./apps/api/
COPY packages/database/package.json          ./packages/database/
COPY packages/shared-types/package.json      ./packages/shared-types/
RUN pnpm install --frozen-lockfile --prod

# Copy built artefacts
COPY --from=builder /app/apps/api/dist                          ./apps/api/dist
COPY --from=builder /app/packages/database/node_modules/.prisma ./packages/database/node_modules/.prisma

# Prisma schema needed for migrate deploy
COPY packages/database/prisma ./packages/database/prisma

# Startup script
COPY apps/api/docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3001
CMD ["./docker-entrypoint.sh"]
