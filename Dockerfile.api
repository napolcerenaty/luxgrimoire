# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the NestJS API in a pnpm monorepo.
# Build context: repository root (so all packages are accessible).

# ── Stage 1: Install + Build ──────────────────────────────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Copy manifests — maximises layer cache on code-only changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json              ./apps/api/
COPY packages/database/package.json     ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/

RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY packages/database  ./packages/database
COPY packages/shared-types ./packages/shared-types
COPY apps/api           ./apps/api

# Generate Prisma client (goes into pnpm virtual store under node_modules/.pnpm)
RUN pnpm --filter @luxgrimoire/database db:generate

# Compile NestJS
RUN pnpm --filter @luxgrimoire/api build

# ── Stage 2: Production runtime ───────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Copy the entire node_modules from builder (includes pnpm virtual store with
# generated Prisma client — trying to copy just .prisma breaks with pnpm)
COPY --from=builder /app/node_modules           ./node_modules
COPY --from=builder /app/apps/api/dist          ./apps/api/dist

# package.json files needed for module resolution
COPY package.json ./
COPY apps/api/package.json              ./apps/api/
COPY packages/database/package.json     ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/

# Prisma schema needed for migrate deploy at startup
COPY packages/database/prisma ./packages/database/prisma

# Startup script
COPY apps/api/docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3001
CMD ["./docker-entrypoint.sh"]
